@@ -9,0 +10,7 @@
+    @Test
+    fun `long public hash should retain folded Fibonacci reference values`() {
+        val keys = longArrayOf(0, 1, -1, 42, Long.MAX_VALUE, Long.MIN_VALUE, 1L shl 48)
+        val expected = intArrayOf(0, -511900244, -511900243, 388080412, 1635583405, -2147483648, 2081751040)
+        for (i in keys.indices) assertEquals(expected[i], fibonacciHash(keys[i]))
+    }
