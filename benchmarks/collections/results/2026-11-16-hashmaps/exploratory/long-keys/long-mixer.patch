+package com.eignex.util.collections
+
+import com.eignex.util.collections.internals.mixLongKey
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertTrue
+
+class LongKeyMixingTest {
+    @Test
+    fun `long table hash should spread sequential and high bit strides`() {
+        for (shift in listOf(0, 8, 16, 24, 32, 40, 48, 56)) {
+            val samples = if (shift == 56) 256 else 4096
+            val mask = samples * 2 - 1
+            for (base in listOf(0L, -1L, Long.MIN_VALUE)) {
+                val slots = HashSet<Int>()
+                repeat(samples) { slots.add(mixLongKey(base + (it.toLong() shl shift)) and mask) }
+                assertTrue(slots.size > samples / 2, "shift=$shift base=$base occupied slots=${slots.size}")
+            }
+        }
+    }
+
+    @Test
+    fun `high bit keys should survive growth deletion and reinsertion in long tables`() {
+        for (shift in listOf(32, 40, 48, 56)) {
+            val count = if (shift == 56) 256 else 1024
+            val keys = LongArray(count) { it.toLong() shl shift }
+            val ints = MutableLongIntMap(1)
+            val objects = MutableLongObjectMap<String?>(1)
+            val set = LongHashSet(1)
+            for (i in keys.indices) {
+                ints.put(keys[i], i)
+                objects.put(keys[i], if (i % 2 == 0) null else "value-$i")
+                assertTrue(set.add(keys[i]))
+            }
+            for (i in keys.indices step 3) {
+                assertTrue(ints.remove(keys[i]))
+                assertTrue(objects.remove(keys[i]))
+                assertTrue(set.remove(keys[i]))
+            }
+            for (i in keys.indices) {
+                val present = i % 3 != 0
+                assertEquals(present, ints.containsKey(keys[i]))
+                assertEquals(present, objects.containsKey(keys[i]))
+                assertEquals(present, keys[i] in set)
+                if (present) {
+                    assertEquals(i, ints.getOrDefault(keys[i], -1))
+                    assertEquals(if (i % 2 == 0) null else "value-$i", objects.getValue(keys[i]))
+                }
+            }
+            for (i in keys.indices step 3) {
+                ints.put(keys[i], -i)
+                objects.put(keys[i], "reinserted-$i")
+                assertTrue(set.add(keys[i]))
+            }
+            assertEquals(count, ints.size)
+            assertEquals(count, objects.size)
+            assertEquals(count, set.size)
+            for (i in keys.indices) {
+                assertEquals(if (i % 3 == 0) -i else i, ints.getOrDefault(keys[i], -1))
+                val expected = if (i % 3 == 0) "reinserted-$i" else if (i % 2 == 0) {
+                    null
+                } else {
+                    "value-$i"
+                }
+                assertEquals(expected, objects.getValue(keys[i]))
+                assertTrue(keys[i] in set)
+            }
+        }
+    }
+}
